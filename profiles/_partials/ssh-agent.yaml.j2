# Shared partial - ssh-agent plug grafted onto the in-project tools SDK
# (draft A-10): forwards the host SSH agent so git over ssh (GitHub, Gerrit,
# Launchpad) works inside the workshop without copying private keys.
# awesome-multirepo hung this plug on vscode-remote, which is forbidden here.
# The system:ssh-agent slot is implicit, so no explicit connection entry is
# needed (workshop auto-connects same-interface plug/slot pairs).
#
# Include immediately after the sdks-chain include so this graft nests under
# the trailing project-<profile>-tools entry.
  plugs:
    ssh-agent:
      interface: ssh-agent
