# Shared partial - MCP OAuth callback tunnel plug + AI-chain connections
# (drafts D-8, D-9).
#
# The opencode SDK pins its MCP OAuth callback listener to localhost:19876
# (canonical/opencode-sdk sdkcraft.yaml, slot opencode-mcp-oauth-callback).
# The system tunnel plug below forwards that loopback endpoint from the host
# so the browser redirect reaches opencode inside the workshop - once the
# plug is CONNECTED. The plug-to-slot pairing is deliberately absent from
# `connections:` (no auto-connect at launch): forwarding host loopback into
# the workshop is an opt-in, on-demand step - `just connect <name>` /
# `just disconnect <name>` (scripts/oauth-tunnel.sh) wire and unwire the
# pair when a consent flow needs it.
#
# One partial, two YAML locations, selected by the `oauth_tunnel_part` jinja
# variable the including template sets before each include:
#   oauth_tunnel_part = 'plug'        nests under `- name: system`
#                                     (right after the system-secret include)
#   oauth_tunnel_part = 'connections' under the top-level `connections:` key
{% if oauth_tunnel_part == 'plug' %}
  plugs:
    mcp-oauth-callback:
      interface: tunnel
      endpoint: localhost:19876
{% elif oauth_tunnel_part == 'connections' %}
# gh-cli:github-token is a manual connection per the gh-cli-sdk README. The
# mcp-oauth-callback tunnel plug deliberately has NO entry here (no
# auto-connect): `just connect <name>` / `just disconnect <name>`
# (scripts/oauth-tunnel.sh) wire it to the opencode SDK's OAuth callback
# slot on demand (D-9).
- plug: gh-cli:github-token
  slot: system:github-token
# The openrouter-key secret plug never auto-connects; scripts/secret-setup.sh
# wires it with `workshop connect`. The ref uses the RUNTIME sdk name because
# the platform strips the `project-` prefix (connection PlugRefs reject
# `project-` names).
- plug: {{ profile }}-tools:openrouter-key
  slot: system:openrouter-key
{% else %}
{# Deliberate render error: set oauth_tunnel_part before including. #}
{{ 1 / 0 }}
{% endif %}
