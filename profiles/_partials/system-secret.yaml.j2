# Shared partial - system SDK secret slots (draft D-8, D-21).
#
# The system SDK declares TWO secret slots:
#   - github-token: the gh-cli SDK reads its token through the
#     github-token secret plug; this slot names the host keyring item,
#     never the token value (canonical/gh-cli-sdk README, "Authenticate").
#     `username: ""` selects the account gh is currently using on the
#     host, so one definition works for everyone on the project; without
#     it the slot matches several keyring items and fails with "multiple
#     secrets match".
#   - openrouter-key: opencode reads its OpenRouter API key through the
#     openrouter-key secret plug; the slot names the keyring item that
#     scripts/secret-setup.sh stores directly (service
#     "sunbeam-workshop-openrouter-key").
#
# After launch the plugs are wired with:
#   workshop connect <name>/gh-cli:github-token <name>/system:github-token
#   workshop connect <name>/<profile>-tools:openrouter-key <name>/system:openrouter-key
# (the connection entries themselves live in oauth-tunnel.yaml.j2).
#
# Include first under the top-level `sdks:` key; the oauth-tunnel "plug"
# fragment nests under this same `- name: system` entry.
- name: system
  slots:
    github-token:
      interface: secret
      attributes:
        service: "gh:github.com"
        username: ""
    openrouter-key:
      interface: secret
      attributes:
        service: "sunbeam-workshop-openrouter-key"
