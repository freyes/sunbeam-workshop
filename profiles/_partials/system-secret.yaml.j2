# Shared partial - system SDK github-token secret slot (draft D-8).
#
# The gh-cli SDK reads its token through the github-token secret plug; this
# slot names the host keyring item, never the token value
# (canonical/gh-cli-sdk README, "Authenticate"). `username: ""` selects the
# account gh is currently using on the host, so one definition works for
# everyone on the project; without it the slot matches several keyring items
# and fails with "multiple secrets match".
#
# After launch the plug is wired with:
#   workshop connect <name>/gh-cli:github-token <name>/system:github-token
# (the connection entry itself lives in oauth-tunnel.yaml.j2).
#
# Include first under the top-level `sdks:` key; the oauth-tunnel "plug"
# fragment nests under this same `- name: system` entry.
- name: system
  slots:
    github-token:
      interface: secret
      attributes:
        service: "gh:github.com"
        username: ""
