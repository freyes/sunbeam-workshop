#!/usr/bin/env bash
# Copyright 2026 Canonical Ltd. All rights reserved.
#
# check-health - charmed-tools SDK health gate. Runs as root; reports through
# workshopctl set-health (see the runtime-hooks contract).
set -euo pipefail

# Shared hook library, tracked at scripts/hooks/lib-common.sh in the repo and
# mounted at /project inside the container. Sourced here for
# run_user_fragments only: this hook runs as root, so the $HOME-based
# provisioning helpers must never be called from it. The shellcheck source
# directive is repo-root-relative so `shellcheck -x` from the repo root can
# follow it.
# shellcheck source=scripts/hooks/lib-common.sh
. /project/scripts/hooks/lib-common.sh

workshop_user="$(getent passwd 1000 | cut -d: -f1)"
if [ -z "$workshop_user" ]; then
    workshopctl set-health --code=missing-workshop-user error \
        "unable to resolve workshop user for uid 1000"
    exit 1
fi

# System tooling from setup-base: charmcraft (snap); git-review and just
# (apt).
for tool in charmcraft git-review just; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        workshopctl set-health --code=missing-system-tooling error \
            "$tool is not on PATH"
        exit 1
    fi
done

# tox is installed per-user by setup-project (uv venv, symlinked into
# ~/.local/bin), so probe it as the workshop user in a login shell.
if ! sudo -u "$workshop_user" bash -lc "command -v tox" >/dev/null 2>&1; then
    workshopctl set-health --code=missing-python-tooling error \
        "tox is not installed for $workshop_user"
    exit 1
fi

# Gerrit identity (draft D-6): without gitreview.username, `git review -s`
# cannot wire the gerrit remote.
gerrit_username="$(sudo -u "$workshop_user" git config --global gitreview.username 2>/dev/null || true)"
if [ -z "$gerrit_username" ]; then
    workshopctl set-health --code=missing-gerrit-username error \
        "gitreview.username is not set for $workshop_user (set gerrit_username in config)"
    exit 1
fi

# The openstack-agentic-skills symlink seeded by setup-project must resolve.
skills_link="/home/$workshop_user/.config/opencode/skills/openstack-agentic-skills"
if ! sudo -u "$workshop_user" test -e "$skills_link"; then
    workshopctl set-health --code=missing-agentic-skills error \
        "$skills_link does not resolve"
    exit 1
fi

# Corrupt-only opencode auth gate: absence of auth.json is an expected
# first-launch state (the openrouter secret plug cannot be connected until
# the workshop is Ready) and MUST NOT fail health; only a present-but-
# malformed file does. An Error-status workshop rejects both `workshop
# connect` and refresh, so only the Ready-instance path or a fresh launch
# can re-converge.
if ! check_opencode_auth "/home/$workshop_user/.local/share/opencode/auth.json"; then
    workshopctl set-health --code=corrupt-opencode-auth error \
        "/home/$workshop_user/.local/share/opencode/auth.json exists but is not valid opencode auth JSON; delete it, then re-converge: re-run 'just secret-setup <name>' on the host if the instance still reports Ready, else 'just remove <name>' and 'just setup <name>' (a fresh launch re-runs the hooks and the writer rebuilds the file from the connected secret)"
    exit 1
fi

# User lifecycle fragments (config/local/hooks/{all,charmed,<hostname>}/
# check-health.d/*.sh) run fail-hard: the first failure's name becomes the
# set-health code and the workshop never reaches Ready.
if ! run_user_fragments check-health charmed; then
    workshopctl set-health --code="user-fragment-${USER_FRAGMENT_FAILURES[0]}" error \
        "user fragment failed: ${USER_FRAGMENT_FAILURES[*]}"
    exit 1
fi

workshopctl set-health okay
