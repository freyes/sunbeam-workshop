#!/usr/bin/env bash
# Copyright 2026 Canonical Ltd. All rights reserved.
#
# setup-project - packaging-tools SDK (runs as the workshop user, post-mount,
# cwd /project).
#
# 1. Seed ~/.dput.d/profiles/ppa.json: a dput-ng PPA upload profile pointing
#    at ppa.launchpad.net, pre-seeded with the user's Launchpad username from
#    the merged vars doc (.config.launchpad_username), so
#    `dput ppa:<ppa-name> <changes>` targets ~<user>/<ppa-name> without
#    repeating it. The profile is plain configuration - no secrets - and
#    signing of source uploads stays a host-side responsibility (A-14).
#    orange-dev-tools ships only the local-repo profile
#    (~/.dput.d/profiles/local.json), so this file is never a duplicate.
# 2. Shared provisioning via /project/scripts/hooks/lib-common.sh (todo 10):
#    Atlassian MCP seed, agentic skills, forge host-key pinning, git identity.

set -euo pipefail

# Shared hook library, tracked at scripts/hooks/lib-common.sh in the repo and
# mounted at /project inside the container. Source it - never duplicate it.
# The shellcheck source directive is repo-root-relative so `shellcheck -x`
# from the repo root can follow it.
# shellcheck source=scripts/hooks/lib-common.sh
. /project/scripts/hooks/lib-common.sh

# write_ppa_profile <vars-doc> - seed ~/.dput.d/profiles/ppa.json. The shape
# mirrors dput-ng's stock ppa profile (/usr/share/dput-ng/profiles/ppa.json)
# with the Launchpad username pre-seeded into the incoming path.
write_ppa_profile() {
    local vars_doc="$1"
    local lp_user profile_dir
    lp_user="$(jq -r '.config.launchpad_username // empty' "$vars_doc")"
    if [ -z "$lp_user" ]; then
        echo "WARNING: config.launchpad_username is not set; skipping the" >&2
        echo "         dput-ng PPA profile. Add it to config/local.json and" >&2
        echo "         re-run 'just setup <name>' to enable 'dput ppa:<ppa-name>'." >&2
        return 0
    fi
    profile_dir="$HOME/.dput.d/profiles"
    mkdir -p "$profile_dir"
    jq -n --arg user "$lp_user" '{
        fqdn: "ppa.launchpad.net",
        incoming: "~\($user)/%(ppa)s",
        login: "anonymous",
        meta: "ubuntu",
        method: "ftp",
        "required-fields": {skip: true},
        "supported-distribution": {
            allowed: ["release"],
            known: ["release", "proposed", "updates", "backports", "security"]
        }
    }' > "$profile_dir/ppa.json.tmp"
    mv "$profile_dir/ppa.json.tmp" "$profile_dir/ppa.json"
    echo "✓ Wrote $profile_dir/ppa.json (dput ppa:<ppa-name> uploads to ~$lp_user/<ppa-name> on ppa.launchpad.net)"
}

# Locate this instance's merged vars doc (persisted by scripts/setup.sh and
# visible here through the /project mount). The hook environment does not
# carry the workshop name, but the kernel hostname IS the bare workshop name
# - upstream canonical/workshop templates /etc/hostname from
# user.workshop.name; <WORKSHOP>.<PROJECT>.wp is only the DNS-level friendly
# name - so find_vars_doc resolves the doc by hostname, with a
# single-profile-match fallback. A missing vars doc is a warning that skips
# the identity-dependent steps, never fatal (check-health gates).
if ! vars_doc="$(find_vars_doc packaging)"; then
    echo "WARNING: no merged vars doc for this instance under /project/.state/;" >&2
    echo "         skipping the dput-ng PPA profile and git identity. Persist it" >&2
    echo "         with 'just setup <name>' on the host before a manual launch." >&2
    vars_doc=""
fi

if [ -n "$vars_doc" ]; then
    run_step "write_ppa_profile $vars_doc" write_ppa_profile "$vars_doc"
fi

run_step "seed_atlassian_mcp" seed_atlassian_mcp
run_step "install_agentic_skills" install_agentic_skills
run_step "pin_forge_host_keys" pin_forge_host_keys

if [ -n "$vars_doc" ]; then
    run_step "apply_git_identity $vars_doc" apply_git_identity "$vars_doc"
fi

# opencode OpenRouter auth: converge ~/.local/share/opencode/auth.json from
# the openrouter-key secret plug. The plug is wired by `just secret-setup
# <name>` post-launch (manual secret connects cannot happen during the
# launch change); refresh/restore re-derive the file via this step.
run_step "write_opencode_auth" write_opencode_auth packaging-tools.openrouter-key

# User lifecycle fragments (config/local/hooks/{all,packaging,<hostname>}/
# setup-project.d/*.sh) run fail-soft as the last step; check-health gates
# its own fragment set fail-hard.
run_step "user fragments" run_user_fragments setup-project packaging
