#!/usr/bin/env bash
# Copyright 2026 Canonical Ltd. All rights reserved.
#
# check-health - packaging-tools SDK (runs as root). Reports through
# workshopctl set-health; any gate failure sets an error health with a stable
# --code and exits 1.
#
# Gates:
#   * sbuild, dput on PATH            (orange-dev-tools' apt list)
#   * gbp, quilt, autopkgtest on PATH (this SDK's setup-base gap-fill)
#   * just on PATH                    (this SDK's setup-base baseline;
#                                      the repo's recipes run in-workshop)
#   * ~/.sbuildrc exists              (written by orange-dev-tools'
#                                      setup-project; gated, never written,
#                                      by this SDK)

set -euo pipefail

# Shared hook library, tracked at scripts/hooks/lib-common.sh in the repo and
# mounted at /project inside the container. Sourced here for
# run_user_fragments only: this hook runs as root, so the $HOME-based
# provisioning helpers must never be called from it. The shellcheck source
# directive is repo-root-relative so `shellcheck -x` from the repo root can
# follow it.
# shellcheck source=scripts/hooks/lib-common.sh
. /project/scripts/hooks/lib-common.sh

fail() {
    local code="$1" message="$2"
    workshopctl set-health --code="$code" error "$message"
    exit 1
}

for tool in sbuild dput gbp quilt autopkgtest just; do
    command -v "$tool" >/dev/null 2>&1 \
        || fail "missing-$tool" "$tool is not on PATH"
done

workshop_user="$(getent passwd 1000 | cut -d: -f1)"
[ -n "$workshop_user" ] \
    || fail "missing-workshop-user" "unable to resolve workshop user for uid 1000"
user_home="$(getent passwd 1000 | cut -d: -f6)"

[ -f "$user_home/.sbuildrc" ] \
    || fail "missing-sbuildrc" \
        "$user_home/.sbuildrc does not exist; orange-dev-tools setup-project did not complete"

# Corrupt-only opencode auth gate: absence of auth.json is an expected
# first-launch state (the openrouter secret plug cannot be connected until
# the workshop is Ready) and MUST NOT fail health; only a present-but-
# malformed file does. An Error-status workshop rejects both `workshop
# connect` and refresh, so only the Ready-instance path or a fresh launch
# can re-converge.
if ! check_opencode_auth "/home/$workshop_user/.local/share/opencode/auth.json"; then
    workshopctl set-health --code=corrupt-opencode-auth error \
        "/home/$workshop_user/.local/share/opencode/auth.json exists but is not valid opencode auth JSON; delete it, then re-converge: re-run 'just secret-setup <name>' on the host if the instance still reports Ready, else 'just remove <name>' and 'just setup <name>' (a fresh launch re-runs the hooks and the writer rebuilds the file from the connected secret)"
    exit 1
fi

# User lifecycle fragments (config/local/hooks/{all,packaging,<hostname>}/
# check-health.d/*.sh) run fail-hard: the first failure's name becomes the
# set-health code and the workshop never reaches Ready.
if ! run_user_fragments check-health packaging; then
    workshopctl set-health --code="user-fragment-${USER_FRAGMENT_FAILURES[0]}" error \
        "user fragment failed: ${USER_FRAGMENT_FAILURES[*]}"
    exit 1
fi

workshopctl set-health okay
