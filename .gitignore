# Rendered workshop instances (tracked sources: .workshop/*/sdk.yaml, hooks)
.workshop/*.yaml

# User-owned in-project SDKs (never committed)
.workshop/*-user-tools/

# Working clones created by `just repos` (host checkouts; inside the
# container the checkout root is /project)
git/

# Local apt repo provisioned inside a launched packaging workshop by the
# orange-dev-tools SDK hook (dput local / sbuild / mini-dinstall state).
# Kept byte-identical to the line that hook appends when it is missing,
# so a launch never leaves an uncommitted .gitignore diff behind.
local-repo/

# Runtime state and credentials
.state/
.openchamber-password

# Per-user configuration
config/local.json
config/*/config.json
config/local/

# Local tooling and build artifacts
scripts/.venv/
__pycache__/
docs/_build/

# Execution evidence
.omo/evidence/
