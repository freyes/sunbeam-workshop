# Runtime state and credentials
.state/
.openchamber-password

# Per-user configuration
config/local.json
config/*/config.json
config/local/

# Local tooling and build artifacts
scripts/.venv/
__pycache__/
docs/_build/

# Execution evidence
.omo/evidence/
